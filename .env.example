# Copia este archivo a .env y ajusta los valores.
# docker-compose y Kedro (vía OmegaConf) leen estas variables.

# --- Base de datos SQL ---
# Local (por defecto, sin servidor): SQLite -> no necesitas definir DB_URL.
# Para usar Postgres localmente, descomenta y ajusta:
# DB_URL=postgresql+psycopg2://nhanes:nhanes@localhost:5432/nhanes

# Credenciales de Postgres (usadas por docker-compose para construir DB_URL)
POSTGRES_USER=nhanes
POSTGRES_PASSWORD=nhanes
POSTGRES_DB=nhanes
POSTGRES_PORT=5432

# --- Servicios ---
API_URL=http://localhost:8000
REPORTING_DIR=data/08_reporting
