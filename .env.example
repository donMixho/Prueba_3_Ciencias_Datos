# Copia este archivo a .env y ajusta los valores.
# docker-compose y Kedro (vía OmegaConf) leen estas variables.

# --- Base de datos SQL (Postgres) ---
POSTGRES_USER=nhanes
POSTGRES_PASSWORD=nhanes
POSTGRES_DB=nhanes
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Servicios ---
API_URL=http://localhost:8000
REPORTING_DIR=data/08_reporting
