# Imagen del pipeline ETL (Kedro)
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Dependencias del sistema mínimas (psycopg2, pyarrow)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Instala dependencias primero (mejor uso de caché de capas)
COPY requirements.txt ./
RUN pip install -r requirements.txt

# Copia el proyecto (los datos NO se copian: ver .dockerignore)
COPY pyproject.toml README.md ./
COPY conf ./conf
COPY src ./src
COPY scripts ./scripts

RUN pip install -e .

# En runtime: asegura los datos (descarga + convierte a CSV) y corre el ETL.
# Los datos se persisten en el volumen montado en /app/data.
CMD ["sh", "-c", "python scripts/download_nhanes.py && python scripts/xpt_to_csv.py && kedro run"]
